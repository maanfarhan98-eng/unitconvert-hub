# ==============================================================================
# UnitConvert Hub — Environment Configuration
# ==============================================================================

# Canonical Application URL
# Used for canonical links, sitemaps, and social share cards
VITE_SITE_URL="https://unitconvert-hub.online"

# Optional: Custom ExchangeRate API Key
# By default, UnitConvert Hub uses the open, free public endpoint from open.er-api.com
# which requires NO API key. If you wish to use an enterprise ExchangeRate-API tier:
# VITE_EXCHANGE_RATE_API_KEY=""

# Optional: Google Analytics Tracking ID (e.g. G-XXXXXXXXXX)
# VITE_GA_MEASUREMENT_ID=""

# Optional: Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
# VITE_ADSENSE_CLIENT_ID=""
